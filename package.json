{
  "name": "prusaslicer-openprinttag-import",
  "private": true,
  "version": "0.1.2",
  "description": "Import OpenPrintTag material data as PrusaSlicer filament presets",
  "repository": "https://github.com/Zsoldier/PrusaSlicer-OpenPrintTagImport",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && tsc -p electron/tsconfig.json && vite build",
    "package": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "test": "vitest run electron/*.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "electron-updater": "^6.6.8",
    "ini": "^5.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "org.openprinttag.prusaslicer-importer",
    "productName": "OpenPrintTag Importer",
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "notarize": true,
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "Zsoldier",
      "repo": "PrusaSlicer-OpenPrintTagImport"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@41.10.7": true
  }
}
